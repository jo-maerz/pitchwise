# Copy to .env.docker and fill in. Used only by docker-compose.yml.

# --- HTTPS ---
# localhost: local certificate. A real domain: automatic Let's Encrypt certificate.
SITE_ADDRESS=localhost
APP_URL=https://localhost

APP_NAME="Practice Insights"
APP_ENV=production
APP_DEBUG=false
# docker compose run --rm --no-deps -e APP_KEY=x app php artisan key:generate --show
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (host must stay "db") ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=practice_insights
DB_USERNAME=root
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me   # same as DB_PASSWORD

# --- Mail (required: new accounts must click the verification link sent here) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Practice Insights"

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
